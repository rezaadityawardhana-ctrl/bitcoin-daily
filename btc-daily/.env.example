# Copy this file to .env and fill in what you want to use. Everything is optional:
# without any keys you still get the dashboard with filtered headlines.

# --- AI news analysis (Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- iPhone notification (free): install the "ntfy" app, tap +, subscribe to this exact topic name.
#     Anyone who knows the topic name can read it, so keep it long and random.
NTFY_TOPIC=
# Link the notification opens. Set automatically when it runs on GitHub; for local runs, paste your Pages URL.
DASHBOARD_URL=

# --- Email delivery (optional, alternative to notifications). Gmail: create an App Password at
#     https://myaccount.google.com/apppasswords (needs 2-Step Verification). Never use your main password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com
